{
  "name": "agentlink",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test",
    "relay": "bun run packages/relay/src/index.ts",
    "daemon": "bun run packages/daemon/src/index.ts",
    "control": "bun run packages/daemon/src/index.ts control",
    "mcp": "bun run --filter @agentlink/daemon mcp",
    "mcp:proxy": "bun run --filter @agentlink/daemon mcp:proxy",
    "dev": "bun run --filter @agentlink/app dev",
    "build:app": "bun run --filter @agentlink/app build",
    "desktop:web": "bun run packages/desktop-bridge/src/server.ts",
    "desktop:build": "bun build packages/desktop-bridge/web/app.ts --target browser --outfile packages/desktop-bridge/web/app.js --minify && bun build packages/desktop-bridge/gateway-web/login.ts --target browser --outfile packages/desktop-bridge/gateway-web/login.js --minify",
    "desktop:gateway": "bun run packages/desktop-bridge/src/gateway.ts",
    "release:manifest": "bun run scripts/release-manifest.ts",
    "release:workflow": "bun run deploy/kmac-release-workflow.ts",
    "e2e": "bun run scripts/e2e.ts",
    "e2e:agent": "bun run scripts/e2e-agent.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "bun-types": "^1.2.0",
    "typescript": "^5.6.0"
  }
}
