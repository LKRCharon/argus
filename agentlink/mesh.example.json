        "PEER_NODE_FINGERPRINT"
      ]
    }
  ],
  "requesters": [
    "PEER_NODE_FINGERPRINT"
  ],
  "legacyControl": false,
  "allowedRoots": [
    "/srv/argus/workspaces"
  ],
  "quarantineRoot": "/srv/argus/quarantine",
